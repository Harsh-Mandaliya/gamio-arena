# Copy to server/.env and change what you need. Every value is optional.

PORT=4000

# Where the SQLite database lives (relative to /server)
DB_FILE=data/gamio.db

# true  = first start fills the database with demo halls, players and bookings
# false = first start creates only the game types and one admin account (use this at a real venue)
DEMO_MODE=true

# Admin account created on first start when DEMO_MODE=false.
# Leave ADMIN_PASSWORD empty and a random one is printed in the terminal once.
ADMIN_EMAIL=admin@gamio.local
ADMIN_PASSWORD=

# Leave empty and a random secret is generated into data/jwt.secret on first run
JWT_SECRET=

# Players may cancel (with a wallet refund) up to this many hours before start
CANCEL_WINDOW_HOURS=2

# How far ahead players can book
BOOKING_HORIZON_DAYS=30

# Where `npm run backup` writes copies (relative to /server)
BACKUP_DIR=data/backups
